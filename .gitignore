# === Python sub-products ===
__pycache__/
*.py[cod]
*$py.class
.venv
venv/
ENV/
env/

# === IDE settings ===
.vscode/
.idea/

# === Data and Heavy Files Exclusion ===
# Ignore all raw and segmented audio files to avoid exceeding GitHub's size limit
data/raw/
data/segmented/

# Ignore CSV result files automatically generated by the models
# (This prevents the repository from being cluttered with large temporal score files)
data/processed/
*.csv

# But keep one essential exception: the manual listening log
!data/metadata/manual_listening_complete_project.csv

# === Plots Exclusion (Optional) ===
# If you want generated PDFs and PNGs to remain only on your local machine,
# uncomment the line below. If you want to upload the figures to GitHub, keep it commented.
# plots/

# === OS temporary files ===
.DS_Store
Thumbs.db